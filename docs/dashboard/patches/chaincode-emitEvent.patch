diff --git a/orgs/hospital/EHR_hospitalOrg-main/ehr-chaincode-v3/lib/dashboardEvents.js b/orgs/hospital/EHR_hospitalOrg-main/ehr-chaincode-v3/lib/dashboardEvents.js
