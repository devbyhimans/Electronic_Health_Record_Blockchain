{
  "name": "lab-ehr-network",
  "version": "1.0.0",
  "client": {
    "tlsEnable": true,
    "adminCredential": {
      "id": "exploreradmin",
      "password": "exploreradminpw"
    },
    "enableAuthentication": false,
    "organization": "LabMSP",
    "connection": {
      "timeout": {
        "peer": {
          "endorser": "300"
        }
      }
    }
  },
  "channels": {
    "ehrchannel": {
      "peers": {
        "peer0.lab.example.com": {}
      }
    }
  },
  "organizations": {
    "LabMSP": {
      "mspid": "LabMSP",
      "adminPrivateKey": {
        "path": "/tmp/crypto/peerOrganizations/lab.example.com/users/Admin@lab.example.com/msp/keystore/priv_sk"
      },
      "signedCert": {
        "path": "/tmp/crypto/peerOrganizations/lab.example.com/users/Admin@lab.example.com/msp/signcerts/Admin@lab.example.com-cert.pem"
      },
      "peers": [
        "peer0.lab.example.com"
      ]
    }
  },
  "peers": {
    "peer0.lab.example.com": {
      "url": "grpcs://peer0.lab.example.com:7051",
      "tlsCACerts": {
        "path": "/tmp/crypto/peerOrganizations/lab.example.com/tlsca/tlsca.lab.example.com-cert.pem"
      },
      "grpcOptions": {
        "ssl-target-name-override": "peer0.lab.example.com"
      }
    }
  },
  "orderers": {
    "orderer.example.com": {
      "url": "grpcs://orderer.example.com:7050",
      "tlsCACerts": {
        "path": "/tmp/crypto/ordererOrganizations/example.com/tlsca/tlsca.example.com-cert.pem"
      },
      "grpcOptions": {
        "ssl-target-name-override": "orderer.example.com"
      }
    }
  }
}
