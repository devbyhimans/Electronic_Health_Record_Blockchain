# Optional dashboard API. Copy values into your own environment; never commit .env.
NODE_ENV=development
DASHBOARD_HOST=0.0.0.0
PORT=4010

# Fallback key for peer0-api JWTs when DASHBOARD_JWT_SECRETS is unset.
JWT_SECRET=replace-with-peer0-api-jwt-secret
# Optional comma-separated verification keys, tried in order. First key is peer0-api;
# add the extorg-api key as the second entry to enable approved lab-role tokens.
# To enable extorg-api users, add that key only to your own local environment.
DASHBOARD_JWT_SECRETS=

# Relative to repository root. These files contain non-secret topology and policy only.
DASHBOARD_TOPOLOGY_CONFIG=orgs/hospital/EHR_hospitalOrg-main/ehr-backend-v3/dashboard-api/config/topology.json
DASHBOARD_AUTHZ_CONFIG=orgs/hospital/EHR_hospitalOrg-main/ehr-backend-v3/dashboard-api/config/authorization.json
DASHBOARD_AUTH_STUB=false

# Append-only disposable event-store data. Use a repository-relative directory
# named "data" under dashboard-api so it stays excluded from Git.
DASHBOARD_DATA_DIR=orgs/hospital/EHR_hospitalOrg-main/ehr-backend-v3/dashboard-api/data
DASHBOARD_STORE_MAX_FILE_BYTES=10485760
DASHBOARD_STORE_MAX_FILES=5

# Fabric block collector: credentials are optional locally and are never sourced
# from gateway wallets or service .env files. Keep credentials in ignored
# dashboard-api/credentials/ and set paths relative to the repository root.
DASHBOARD_COLLECTOR_ENABLED=true
DASHBOARD_FABRIC_PEER_ID=
DASHBOARD_FABRIC_GATEWAY_ENDPOINT=
DASHBOARD_FABRIC_PEER_HOST_ALIAS=replace-with-peer-tls-hostname
DASHBOARD_FABRIC_TLS_ROOT_CERT_PATH=
DASHBOARD_FABRIC_TLS_CLIENT_CERT_PATH=
DASHBOARD_FABRIC_TLS_CLIENT_KEY_PATH=
DASHBOARD_FABRIC_IDENTITY_CERT_PATH=
DASHBOARD_FABRIC_IDENTITY_KEY_PATH=
DASHBOARD_FABRIC_MSP_ID=HospitalMSP
DASHBOARD_FABRIC_CHANNEL=ehrchannel
DASHBOARD_FABRIC_CHAINCODE=ehr
COLLECTOR_BACKFILL_BLOCKS=200

# Optional HTTP health targets. Blank peer operations and orderer URLs remain
# NOT_CONFIGURED until a read-only HTTP endpoint is supplied.
DASHBOARD_HEALTH_PEER0_OPERATIONS_URL=
DASHBOARD_HEALTH_PEER1_OPERATIONS_URL=
DASHBOARD_HEALTH_PEER2_OPERATIONS_URL=
DASHBOARD_HEALTH_DIAGNOSTICS_OPERATIONS_URL=
DASHBOARD_HEALTH_PROVIDER_OPERATIONS_URL=
DASHBOARD_HEALTH_ORDERER_URL=
DASHBOARD_HEALTH_PEER0_API_URL=http://localhost:4001/health
DASHBOARD_HEALTH_PEER1_API_URL=http://localhost:4002/health
DASHBOARD_HEALTH_PEER2_API_URL=http://localhost:4003/health
DASHBOARD_HEALTH_PATIENT_API_URL=http://localhost:4005/health
DASHBOARD_HEALTH_EXTORG_API_URL=http://localhost:4004/health
DASHBOARD_HEALTH_IPFS_URL=http://localhost:4006/health
DASHBOARD_HEALTH_PHARMACY_URL=http://localhost:3000/api/network-status
DASHBOARD_HEALTH_INTERVAL_MS=15000
DASHBOARD_HEALTH_TIMEOUT_MS=3000
DASHBOARD_HEALTH_FAILURE_THRESHOLD=3
DASHBOARD_HEALTH_MAX_CONCURRENCY=4
DASHBOARD_AGENT_HEARTBEAT_INTERVAL_MS=15000
DASHBOARD_AGENT_MISSED_INTERVALS=3
DASHBOARD_FABRIC_CONNECT_TIMEOUT_MS=5000

# Realtime client limits; REST, WebSocket, SSE and replay share role filtering.
DASHBOARD_STREAM_MAX_CLIENTS=500
DASHBOARD_STREAM_MAX_BUFFER_BYTES=1048576
DASHBOARD_STREAM_HEARTBEAT_MS=20000
DASHBOARD_STREAM_REPLAY_LIMIT=200

# Ingest and mock demonstration are disabled without an operator-configured key.
DASHBOARD_SERVICE_KEY=
DASHBOARD_INGEST_MAX_BODY_BYTES=1048576
DASHBOARD_INGEST_MAX_BATCH_SIZE=100
DASHBOARD_INGEST_RATE_LIMIT=300
DASHBOARD_ALLOW_MOCK=false

# Local-network defaults; override for container DNS or another deployment.
DASHBOARD_PEER_HOSPITAL_RECEPTION=localhost:7051
DASHBOARD_PEER_HOSPITAL_DOCTOR=localhost:9051
DASHBOARD_PEER_HOSPITAL_NURSE=localhost:10051
DASHBOARD_PEER_DIAGNOSTICS=localhost:8051
DASHBOARD_PEER_PROVIDER=localhost:11051
DASHBOARD_ORDERER=localhost:7050
