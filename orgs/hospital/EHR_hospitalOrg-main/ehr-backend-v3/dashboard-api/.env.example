# Optional dashboard API. Copy values into your own environment; never commit .env.
NODE_ENV=development
DASHBOARD_HOST=0.0.0.0
PORT=4010

# Fallback key for peer0-api JWTs when DASHBOARD_JWT_SECRETS is unset.
JWT_SECRET=replace-with-peer0-api-jwt-secret
# Optional comma-separated verification keys, tried in order. First key is peer0-api;
# add the extorg-api key as the second entry to enable approved lab-role tokens.
# To enable extorg-api users, add that key only to your own local environment.
DASHBOARD_JWT_SECRETS=

# Relative to repository root. These files contain non-secret topology and policy only.
DASHBOARD_TOPOLOGY_CONFIG=orgs/hospital/EHR_hospitalOrg-main/ehr-backend-v3/dashboard-api/config/topology.json
DASHBOARD_AUTHZ_CONFIG=orgs/hospital/EHR_hospitalOrg-main/ehr-backend-v3/dashboard-api/config/authorization.json
DASHBOARD_AUTH_STUB=false

# Local-network defaults; override for container DNS or another deployment.
DASHBOARD_PEER_HOSPITAL_RECEPTION=localhost:7051
DASHBOARD_PEER_HOSPITAL_DOCTOR=localhost:9051
DASHBOARD_PEER_HOSPITAL_NURSE=localhost:10051
DASHBOARD_PEER_DIAGNOSTICS=localhost:8051
DASHBOARD_PEER_PROVIDER=localhost:11051
DASHBOARD_ORDERER=localhost:7050
