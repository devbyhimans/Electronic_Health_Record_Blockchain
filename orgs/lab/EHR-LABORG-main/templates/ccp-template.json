{
  "name": "lab-ehr-network",
  "version": "1.0.0",
  "client": {
    "organization": "LabMSP",
    "connection": {
      "timeout": {
        "peer": {
          "endorser": "300"
        }
      }
    }
  },
  "organizations": {
    "LabMSP": {
      "mspid": "LabMSP",
      "peers": [
        "peer0.lab.example.com",
        "peer1.lab.example.com",
        "peer2.lab.example.com"
      ]
    }
  },
  "channels": {
    "ehrchannel": {
      "orderers": [
        "orderer.example.com"
      ],
      "peers": {
        "peer0.lab.example.com": {
          "endorsingPeer": true,
          "chaincodeQuery": true,
          "ledgerQuery": true,
          "eventSource": true
        },
        "peer1.lab.example.com": {
          "endorsingPeer": true,
          "chaincodeQuery": true,
          "ledgerQuery": true,
          "eventSource": true
        },
        "peer2.lab.example.com": {
          "endorsingPeer": true,
          "chaincodeQuery": true,
          "ledgerQuery": true,
          "eventSource": true
        }
      }
    }
  },
  "peers": {
    "peer0.lab.example.com": {
      "url": "grpcs://peer0.lab.example.com:7051",
      "tlsCACerts": {
        "pem": "${PEERPEM}"
      }
    },
    "peer1.lab.example.com": {
      "url": "grpcs://peer1.lab.example.com:7051",
      "tlsCACerts": {
        "pem": "${PEERPEM}"
      }
    },
    "peer2.lab.example.com": {
      "url": "grpcs://peer2.lab.example.com:7051",
      "tlsCACerts": {
        "pem": "${PEERPEM}"
      }
    }
  },
  "orderers": {
    "orderer.example.com": {
      "url": "grpcs://orderer.example.com:7050",
      "tlsCACerts": {
        "pem": "${ORDERERPEM}"
      }
    }
  }
}
