# Pharmacy Org Deployment Environment Configuration
# Copy this to deploy.env to override the single-node defaults

# IP addresses of the 3 physical machines (leave empty for single-node mode)
PC1_IP="127.0.0.1"
PC2_IP=""
PC3_IP=""

# SSH Users for the remote machines
PC2_USER=""
PC3_USER=""

# Absolute paths to Fabric binaries and config
# FABRIC_BIN="/path/to/fabric-samples/bin"
# FABRIC_CFG="/path/to/fabric-samples/config"
